<footer id="footer">
  <% if (theme.sidebar === 'bottom'){ %>
    <%- partial('_partial/sidebar') %>
  <% } %>
  <div class="outer">
    <div id="footer-info" class="inner">
      <% if (theme.copyright){ %>
        <%- render(theme.copyright, 'pug'); %>
      <% } %>
      &copy; <%= date(new Date(), 'YYYY') %> <%= config.author || config.title %><br>
      <%= __('powered_by') %> <a href="https://hexo.io/" target="_blank">Hexo</a>
    </div>
  </div>
</footer>
<div id="miya-skin-toggle" role="button" tabindex="0" aria-label="切换皮肤" title="宣纸 / 盐雾 / 夜航">🌙</div>
<script>(function(){
  var t = document.getElementById('miya-skin-toggle');
  var ORDER = ['paper','haze','night'];
  var ICON = {paper:'🌫', haze:'🌙', night:'☀️'};
  function cur(){
    var a = document.documentElement.getAttribute('data-skin');
    return (a === 'night' || a === 'haze') ? a : 'paper';
  }
  function label(){
    var c = cur();
    var nxt = ORDER[(ORDER.indexOf(c) + 1) % ORDER.length];
    t.textContent = ICON[nxt];
  }
  label();
  function flip(){
    var c = cur();
    var nxt = ORDER[(ORDER.indexOf(c) + 1) % ORDER.length];
    if (nxt === 'paper') { document.documentElement.removeAttribute('data-skin'); }
    else { document.documentElement.setAttribute('data-skin', nxt); }
    label();
    try { localStorage.setItem('miya-skin', nxt); } catch(e) {}
  }
  t.addEventListener('click', flip);
  t.addEventListener('keydown', function(e){ if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); flip(); } });
})();</script>
